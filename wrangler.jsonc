{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "pillaisyogicculture-com",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./public",
  },
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "pillaisyogicculture.com",
      "custom_domain": true,
    },
  ],
}
